# ==============================================================================
# Database Configuration for Student Record Management System
# ==============================================================================
# Copy this file to .env and fill in your MySQL server credentials:
#   cp .env.example .env
#
# Supports any remote / free cloud MySQL provider (e.g. Aiven.io, Clever Cloud,
# PlanetScale, FreeMySQLHosting, Railway, or standard local MySQL).
# ==============================================================================

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional: Connection pool and timeout settings
DB_POOL_NAME=student_pool
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=10
